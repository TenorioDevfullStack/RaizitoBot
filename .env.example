# RaizitoBot environment template
# Copy this file to .env and replace placeholders with real values.
# Never commit your real .env file.


# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------

# Required for polling and webhook modes.
# Create a bot and get the token from @BotFather.
TELEGRAM_TOKEN=123456789:replace_with_your_telegram_bot_token

# Optional, but recommended for webhook deployments.
# Use a long random string. This must match the secret_token configured in setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret


# -----------------------------------------------------------------------------
# Google Gemini
# -----------------------------------------------------------------------------

# Required for chat, summaries, image analysis, audio transcription and drafts.
# Get it from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional model override.
# Current default used by the app when unset: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
# Local database
# -----------------------------------------------------------------------------

# Optional.
# If unset, the app chooses a local default. On Windows, it falls back to
# data/bot_data.db when the system drive is out of space.
DB_PATH=data/bot_data.db


# -----------------------------------------------------------------------------
# Admin operations panel
# -----------------------------------------------------------------------------

# Optional.
# Set true to start the local operations panel inside the bot process.
ADMIN_PANEL_ENABLED=false

# Optional.
# Use 0.0.0.0 inside Docker. Publish it only to localhost on the VM.
ADMIN_PANEL_HOST=0.0.0.0
ADMIN_PANEL_PORT=8080

# Required when ADMIN_PANEL_ENABLED=true.
# Use a long random value. Access the panel through an SSH tunnel or private network.
ADMIN_PANEL_TOKEN=replace_with_a_long_random_admin_panel_token

# Optional.
ADMIN_PANEL_BACKUP_DIR=data/backups
LOG_FILE=data/bot.log

# Optional.
# When false, the panel only observes Telegram users. When true, only active users
# in the panel or IDs listed in AUTHORIZED_USER_IDS can use the bot.
ENFORCE_AUTHORIZED_USERS=false
AUTHORIZED_USER_IDS=


# -----------------------------------------------------------------------------
# RAG vector store
# -----------------------------------------------------------------------------

# Required to connect the bot to Supabase pgvector in production.
# Use "supabase" to force Supabase, "auto" to use Supabase when configured,
# or "sqlite" to keep everything local.
RAG_VECTOR_BACKEND=sqlite

# Optional.
# Keep true so the bot continues using SQLite if Supabase is temporarily down.
RAG_SUPABASE_FALLBACK_TO_SQLITE=true

# Required when RAG_VECTOR_BACKEND=supabase.
# Run supabase/knowledge_items.sql in the Supabase SQL Editor first.
# Fill with Project Settings > API > Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Fill with Project Settings > API > service_role secret.
# Server-only secret. Never expose it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Optional Supabase REST settings.
SUPABASE_SCHEMA=public
SUPABASE_KNOWLEDGE_TABLE=knowledge_items
SUPABASE_MATCH_FUNCTION=match_knowledge_items
SUPABASE_REQUEST_TIMEOUT=10


# -----------------------------------------------------------------------------
# Google Custom Search
# -----------------------------------------------------------------------------

# Required for /search.
# Enable Custom Search API in Google Cloud and create an API key.
GOOGLE_SEARCH_API_KEY=replace_with_your_google_custom_search_api_key

# Required for /search.
# Create a Programmable Search Engine and copy its CX ID.
GOOGLE_SEARCH_CX=replace_with_your_programmable_search_engine_cx


# -----------------------------------------------------------------------------
# Google Workspace service account and MCP tools
# -----------------------------------------------------------------------------

# Required for Gmail, Drive, Calendar and Docs features in the Telegram bot and
# in the MCP server exposed by bot/mcp_google_server.py.
# Enable these APIs in Google Cloud:
# - Gmail API
# - Google Drive API
# - Google Calendar API
# - Google Docs API
#
# Also share the target Drive files/folders and Calendar with the service account.
# For Calendar event creation, grant "Make changes to events".
#
# Use either GOOGLE_SERVICE_ACCOUNT_FILE for local development OR
# GOOGLE_SERVICE_ACCOUNT_JSON for production platforms.

# Option 1: local path to the service account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option 2: full service account JSON as a single-line string.
# Leave empty when using GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional.
# Use only if your Google Workspace/domain setup supports domain-wide delegation.
# Example: you@yourdomain.com
GOOGLE_DELEGATED_USER=

# Optional.
# Global switch for domain-wide delegation. Keep false if you shared Calendar,
# Drive and Docs directly with the service account. Gmail normally requires
# Google Workspace domain-wide delegation.
GOOGLE_USE_DOMAIN_WIDE_DELEGATION=false

# Optional per-service delegation switches.
GOOGLE_GMAIL_USE_DELEGATION=true
GOOGLE_DRIVE_USE_DELEGATION=false
GOOGLE_CALENDAR_USE_DELEGATION=false
GOOGLE_DOCS_USE_DELEGATION=false

# Optional.
# Gmail user id used by the Gmail API. Keep "me" for service account delegation;
# set an email address only if your Google Workspace setup requires it.
GOOGLE_GMAIL_USER_ID=me

# Optional.
# Calendar id used by Calendar tools. Use "primary" or the calendar id from
# Google Calendar settings, usually an email address for the main calendar.
GOOGLE_CALENDAR_ID=primary

# Optional.
# Used when creating Calendar events.
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo


# -----------------------------------------------------------------------------
# Google Maps
# -----------------------------------------------------------------------------

# Required for Maps MCP tools.
# Enable these APIs as needed in Google Cloud:
# - Geocoding API
# - Directions API
# - Places API
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key

# Optional.
# Response language for Google Maps APIs.
GOOGLE_MAPS_LANGUAGE=pt-BR


# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------

# Optional.
# Default is stdio, which is what desktop/agent MCP clients usually expect.
# Run with: python -m bot.mcp_google_server
MCP_TRANSPORT=stdio


# -----------------------------------------------------------------------------
# External app integration
# -----------------------------------------------------------------------------

# Optional.
# Used by /app_status through bot/external_integration.py.
# The current integration is a placeholder/mock for https://pro.raizeletrica.com.br.
APP_USERNAME=replace_with_external_app_username_or_email
APP_PASSWORD=replace_with_external_app_password

# Optional.
# Base URL used by /app_status through bot/external_integration.py.
CUSTOM_API_URL=https://pro.raizeletrica.com.br


# -----------------------------------------------------------------------------
# Deployment notes
# -----------------------------------------------------------------------------

# Vercel sets VERCEL automatically; do not set it locally unless you know why.
# For webhook deployments, configure Telegram with:
# https://api.telegram.org/bot<TELEGRAM_TOKEN>/setWebhook?url=https://YOUR_DOMAIN/api/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
