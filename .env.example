# RaizitoBot environment template
# Copy this file to .env and replace placeholders with real values.
# Never commit your real .env file.


# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------

# Required for polling and webhook modes.
# Create a bot and get the token from @BotFather.
TELEGRAM_TOKEN=123456789:replace_with_your_telegram_bot_token

# Optional, but recommended for webhook deployments.
# Use a long random string. This must match the secret_token configured in setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret


# -----------------------------------------------------------------------------
# Google Gemini
# -----------------------------------------------------------------------------

# Required for chat, summaries, image analysis, audio transcription and drafts.
# Get it from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional model override.
# Current default used by the app when unset: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash


# -----------------------------------------------------------------------------
# Local database
# -----------------------------------------------------------------------------

# Optional.
# If unset, the app chooses a local default. On Windows, it falls back to
# data/bot_data.db when the system drive is out of space.
DB_PATH=data/bot_data.db


# -----------------------------------------------------------------------------
# Google Custom Search
# -----------------------------------------------------------------------------

# Required for /search.
# Enable Custom Search API in Google Cloud and create an API key.
GOOGLE_SEARCH_API_KEY=replace_with_your_google_custom_search_api_key

# Required for /search.
# Create a Programmable Search Engine and copy its CX ID.
GOOGLE_SEARCH_CX=replace_with_your_programmable_search_engine_cx


# -----------------------------------------------------------------------------
# Google Workspace service account
# -----------------------------------------------------------------------------

# Required for Gmail, Drive, Calendar and Docs features.
# Enable these APIs in Google Cloud:
# - Gmail API
# - Google Drive API
# - Google Calendar API
# - Google Docs API
#
# Also share the target Drive files/folders and Calendar with the service account.
# For Calendar event creation, grant "Make changes to events".
#
# Use either GOOGLE_SERVICE_ACCOUNT_FILE for local development OR
# GOOGLE_SERVICE_ACCOUNT_JSON for production platforms.

# Option 1: local path to the service account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option 2: full service account JSON as a single-line string.
# Leave empty when using GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional.
# Use only if your Google Workspace/domain setup supports domain-wide delegation.
# Example: you@yourdomain.com
GOOGLE_DELEGATED_USER=

# Optional.
# Used when creating Calendar events.
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo


# -----------------------------------------------------------------------------
# External app integration
# -----------------------------------------------------------------------------

# Optional.
# Used by /app_status through bot/external_integration.py.
# The current integration is a placeholder/mock for https://pro.raizeletrica.com.br.
APP_USERNAME=replace_with_external_app_username_or_email
APP_PASSWORD=replace_with_external_app_password

# Optional placeholder for future custom API integrations.
# Not currently read by the active code, but kept here as a documented extension point.
CUSTOM_API_URL=https://your-api.example.com


# -----------------------------------------------------------------------------
# Deployment notes
# -----------------------------------------------------------------------------

# Vercel sets VERCEL automatically; do not set it locally unless you know why.
# For webhook deployments, configure Telegram with:
# https://api.telegram.org/bot<TELEGRAM_TOKEN>/setWebhook?url=https://YOUR_DOMAIN/api/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
